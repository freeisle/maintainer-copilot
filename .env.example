# ===== LLM 主通道(OpenAI 兼容) =====
MC_DEEPSEEK_API_KEY=sk-xxxx
# MC_DEEPSEEK_BASE_URL=https://api.deepseek.com
# MC_PRIMARY_MODEL=deepseek-chat

# ===== 兜底通道(本地 Ollama, OpenAI 兼容协议) =====
# MC_OLLAMA_BASE_URL=http://localhost:11434/v1
# MC_FALLBACK_MODEL=qwen2.5:7b

# ===== 存储与服务 =====
# MC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maintainer_copilot
# MC_GITHUB_WEBHOOK_SECRET=

# ===== GitHub Token(Executor 写操作/评测采集用; 读工具可不配, 走匿名限流) =====
# MC_GITHUB_TOKEN=ghp_xxx

# ===== 已验证的本机扩展（默认仍为混合检索、dry-run） =====
# MC_DRY_RUN=true
# MC_CHECKPOINT_DIR=data/checkpoints
# MC_MEMORY_MAX_TOKENS=4000
# MC_LOCAL_INDEX_PATH=data/retrieval-snapshot.jsonl
# MC_RETRIEVAL_BACKEND=local
# MC_FEDERATION_REPOS={"owner/main":["owner/docs"]}

# ===== 可选 A2A 只读知识服务（见 docs/services.md） =====
# MC_A2A_URL=http://127.0.0.1:8010
# MC_A2A_PUBLIC_URL=http://127.0.0.1:8010/a2a
# MC_A2A_ALLOWED_REPOS=["owner/main","owner/docs"]
# MC_A2A_TOKEN=

# ===== 可选脱敏观测（无 URL 时只本地落盘） =====
# MC_OBSERVABILITY_ENABLED=false
# MC_TRACE_PATH=data/traces.jsonl
# MC_LANGFUSE_URL=http://127.0.0.1:3000
# MC_LANGFUSE_PUBLIC_KEY=
# MC_LANGFUSE_SECRET_KEY=
